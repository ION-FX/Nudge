# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# OpenRouter API key (https://openrouter.ai/keys). Optional: can also be set
# on the first-run /setup page, which stores it in the local database.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model used by the co-pilot. Must exist on OpenRouter; ":free" models need no credits.
MODEL=google/gemma-4-31b-it:free

# Fallback gate for TEACHER registration. Optional: can also be set on /setup.
# Students never need a code.
TEACHER_INVITE_CODE=change-me

# Max upload size in megabytes.
MAX_UPLOAD_MB=10

# Bind address for the dev server. 0.0.0.0 = reachable from LAN + Tailscale;
# use 127.0.0.1 to keep it local-only.
HOST=0.0.0.0
PORT=8000
